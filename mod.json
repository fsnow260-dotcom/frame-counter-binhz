{
  "geode": "v5.0.0",
  "gd": {
    "win": "2.2081",
    "android": "2.2081"
  },
  "id": "yourname.nandl-precision",
  "name": "NaNDL Precision Suite",
  "version": "v1.0.0",
  "developer": "YourName",
  "description": "Sub-frame CBF analytics with NaNDL σ/s solver.",
  "settings": {
    "general-title": {
      "type": "title",
      "name": "NaNDL Solver Configuration"
    },
    "target-prob": {
      "name": "Target Probability",
      "description": "Joint success probability for the σ/s solver",
      "type": "float",
      "default": 0.99,
      "min": 0.5,
      "max": 0.9999,
      "control": { "slider": true }
    },
    "nerve-multiplier": {
      "name": "Nerve Multiplier (K_T)",
      "description": "Late-level pressure adjustment",
      "type": "float",
      "default": 1.15,
      "min": 1.0,
      "max": 2.0,
      "control": { "slider": true }
    },
    "fatigue-multiplier": {
      "name": "Fatigue Modifier (K_U)",
      "description": "Input count stamina decay",
      "type": "float",
      "default": 1.05,
      "min": 1.0,
      "max": 1.5,
      "control": { "slider": true }
    },
    "cps-drain": {
      "name": "CPS Drain (K_C)",
      "description": "Click frequency penalty",
      "type": "float",
      "default": 1.08,
      "min": 1.0,
      "max": 1.5,
      "control": { "slider": true }
    },
    "open-solver": {
      "type": "button",
      "name": "Open Solver Settings",
      "description": "Configure solver parameters in a dedicated popup",
      "buttons": [
        { "name": "Open", "callback": "open-solver-popup" }
      ]
    },
    "reset-solver": {
      "type": "button",
      "name": "Reset to Defaults",
      "buttons": [
        { "name": "Reset", "callback": "reset-solver-settings" }
      ]
    }
  }
}